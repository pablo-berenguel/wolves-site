NUXT_PUBLIC_SITE_URL=http://localhost:3000

# MATOMO (public tracker URL and positive site identifier)
# Disabled by default. Never use the production tracker for local development.
NUXT_PUBLIC_MATOMO_URL=
NUXT_PUBLIC_MATOMO_SITE_ID=

# CMS STORAGE (private server-side values)
# Use an absolute persistent path in production, for example /data.
NUXT_CMS_DATA_DIR=.data

# BIGBADBOT PARTICIPATION PROJECTION (private, read-only)
# Never point this at BigBadBot's raw database.
NUXT_PARTICIPATION_DATA_PATH=.data/stats/participations.sqlite

# BIGBADBOT REGISTRATION BRIDGE (private, server-side only)
# In production, mount the same printable text HMAC key (for example generated
# with `openssl rand -hex 48`) instead of putting its value in an environment
# variable.
NUXT_BIGBADBOT_BRIDGE_URL=http://localhost:8080
NUXT_BIGBADBOT_BRIDGE_SECRET_FILE=.data/secrets/bigbadbot_bridge_hmac
# Production must fail its healthcheck if the bridge is not configured.
NUXT_BIGBADBOT_BRIDGE_REQUIRED=false

# DISCORD OAUTH
# Create an OAuth2 application and register /auth/discord as callback.
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
NUXT_OAUTH_DISCORD_CLIENT_ID=replace-with-discord-client-id
NUXT_OAUTH_DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
NUXT_OAUTH_DISCORD_REDIRECT_URL=http://localhost:3000/auth/discord
# Numeric immutable Discord user ID; never use a username for authorization.
NUXT_CMS_SUPER_ADMIN_DISCORD_ID=replace-with-numeric-discord-user-id
